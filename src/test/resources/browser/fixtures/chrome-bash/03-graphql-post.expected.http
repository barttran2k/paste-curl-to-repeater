{"operationName":"GetUser","variables":{"id":"42","withPosts":true},"query":"query GetUser($id: ID!, $withPosts: Boolean!) {\n  user(id: $id) {\n    id\n    name\n    posts @include(if: $withPosts) { title }\n  }\n}"}