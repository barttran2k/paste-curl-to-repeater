curl -X POST __BASE__/graphql \
  -H 'Content-Type: application/json' \
  -H 'Authorization: Bearer fake' \
  -d '{"query":"query Repo($owner:String!,$name:String!){ repository(owner:$owner,name:$name){ stargazerCount issues(first:2){ nodes{ title } } } }","variables":{"owner":"octocat","name":"Hello-World"}}'
